@page "/documents/{Id:int}"
@using InsuranceAnalyzer.Application.Documents
@inject IPolicyDocumentService DocumentService
@inject NavigationManager Navigation

<PageTitle>Document Details | Insurance Analyzer</PageTitle>

<div class="document-page">
    <button class="back-link" @onclick="BackToDocuments">← Back to documents</button>

    @if (isLoading)
    {
        <p class="muted">Loading document...</p>
    }
    else if (loadError is not null)
    {
        <div class="message error diagnostic-error" role="alert">@loadError</div>
    }
    else if (document is null)
    {
        <section class="panel"><div class="empty-state">
            <h2>Document not found</h2>
            <p class="muted">The requested document does not exist or may have been deleted.</p>
        </div></section>
    }
    else if (details is not null)
    {
        <div class="page-heading">
            <div>
                <p class="eyebrow">DOCUMENT DETAILS</p>
                <h1>@document.OriginalFileName</h1>
                <p class="muted">Review the uploaded policy document and extracted text.</p>
            </div>
            <div class="header-actions">
                <a class="secondary-button action-link" href="@($"/documents/{document.Id}/file")" target="_blank" rel="noopener noreferrer">View PDF</a>
                <a class="primary-button action-link" href="@($"/documents/{document.Id}/file?download=true")">Download</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(document.ProcessingError))
        {
            <div class="message error diagnostic-error" role="alert">
                <strong>Document processing error</strong>
                <div>@document.ProcessingError</div>
            </div>
        }

        @if (!details.UsesPersistedDiagnostics)
        {
            <div class="message diagnostic-error" role="status">
                <strong>Legacy diagnostics</strong>
                Page-level diagnostics were not stored for this document. Text and source labels below are inferred from the original extraction output; OCR attempts and quality scores are unavailable.
            </div>
        }

        <div class="details-grid">
            <section class="panel">
                <div class="panel-heading"><div><h2>Document information</h2><p class="muted">Uploaded file and associated policy.</p></div></div>
                <div class="metadata-grid">
                    <div class="metadata-item"><span class="metadata-label">Policy number</span><strong>@document.PolicyNumber</strong></div>
                    <div class="metadata-item"><span class="metadata-label">Policyholder</span><strong>@document.PolicyholderName</strong></div>
                    <div class="metadata-item"><span class="metadata-label">Original filename</span><strong>@document.OriginalFileName</strong></div>
                    <div class="metadata-item"><span class="metadata-label">File size</span><strong>@FormatFileSize(document.FileSizeBytes)</strong></div>
                    <div class="metadata-item"><span class="metadata-label">Uploaded</span><strong>@document.UploadedUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</strong></div>
                    <div class="metadata-item"><span class="metadata-label">Processing status</span><span class="@GetStatusClass(document.ProcessingStatus)">@document.ProcessingStatus</span></div>
                </div>
            </section>

            <section class="panel">
                <div class="panel-heading"><div><h2>Extraction diagnostics</h2><p class="muted">Quality indicators for subsequent analysis.</p></div></div>
                <div class="diagnostics-list">
                    <DiagnosticRow Label="Text extraction" Value="@ExtractionResult" Success="@(details.CharacterCount > 0)" />
                    <DiagnosticRow Label="Pages detected" Value="@PagesDetected" Success="@(document.PageCount > 0)" />
                    <DiagnosticRow Label="Characters extracted" Value="@details.CharacterCount.ToString("N0")" Success="@(details.CharacterCount > 0)" />
                    <DiagnosticRow Label="OCR attempted" Value="@(details.UsesPersistedDiagnostics ? $"{details.OcrAttemptedCount} page(s)" : "Unknown (legacy)")" Success="@(details.UsesPersistedDiagnostics)" />
                    <DiagnosticRow Label="OCR text returned" Value="@($"{details.OcrSuccessCount} page(s)")" Success="@(details.UsesPersistedDiagnostics)" />
                    <DiagnosticRow Label="Needs review" Value="@(details.UsesPersistedDiagnostics ? $"{details.NeedsReviewCount} page(s)" : "Not evaluated")" Success="@(details.UsesPersistedDiagnostics && details.NeedsReviewCount == 0)" />
                    <DiagnosticRow Label="Missing text" Value="@(details.UsesPersistedDiagnostics ? $"{details.MissingCount} page(s)" : "Not evaluated")" Success="@(details.UsesPersistedDiagnostics && details.MissingCount == 0)" />
                    <DiagnosticRow Label="Quality warnings" Value="@(details.UsesPersistedDiagnostics ? details.WarningCount.ToString("N0") : "Not evaluated")" Success="@(details.UsesPersistedDiagnostics && details.WarningCount == 0)" />
                    <DiagnosticRow Label="Processing errors" Value="@(string.IsNullOrWhiteSpace(document.ProcessingError) ? "None" : "Yes")" Success="@(string.IsNullOrWhiteSpace(document.ProcessingError))" />
                </div>
            </section>
        </div>

        <section class="panel extracted-text-panel">
            <div class="panel-heading extracted-heading">
                <div><h2>Extracted text and page diagnostics</h2><p class="muted">Page-by-page extraction details and quality warnings.</p></div>
                <div class="text-summary">@details.Pages.Count page(s) · @details.CharacterCount.ToString("N0") characters</div>
            </div>
            @if (details.Pages.Count == 0)
            {
                <div class="empty-state"><h3>No extractable text or page diagnostics</h3></div>
            }
            else
            {
                <div class="page-list">
                    @foreach (var extractedpage in details.Pages)
                    {
                        <article class="extracted-page" @key="extractedpage.PageNumber">
                            <div class="extracted-page-header">
                                <strong>Page @extractedpage.PageNumber</strong>
                                <span>@SourceLabel(extractedpage.Source)</span>
                                <span>@extractedpage.CharacterCount.ToString("N0") characters</span>
                                <span class="@GetQualityClass(extractedpage.QualityStatus)">@QualityLabel(extractedpage.QualityStatus)</span>
                            </div>
                            <div class="page-diagnostic-meta">
                                <span>OCR attempted: @(extractedpage.OcrAttempted is null ? "Unknown" : extractedpage.OcrAttempted.Value ? "Yes" : "No")</span>
                                @if (extractedpage.HasPersistedDiagnostics)
                                {
                                    <span>Persisted diagnostics</span>
                                }
                            </div>
                            @if (extractedpage.Warnings.Count > 0)
                            {
                                <div class="page-warning-list" aria-label="Page quality warnings">
                                    @foreach (var warning in extractedpage.Warnings)
                                    {
                                        <div class="page-warning" role="note">
                                            <strong>@warning.Severity — @warning.Code:</strong> @warning.Message
                                        </div>
                                    }
                                </div>
                            }
                            @if (string.IsNullOrEmpty(extractedpage.Text))
                            {
                                <p class="page-empty-text">[No text extracted]</p>
                            }
                            else
                            {
                                <pre class="extracted-page-text">@extractedpage.Text</pre>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private PolicyDocumentDto? document;
    private DocumentDetailsProjection.Result? details;
    private bool isLoading = true;
    private string? loadError;

    
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadError = null;
        document = null;
        details = null;

        try
        {
            document = await DocumentService.GetByIdAsync(Id);

            if (document is not null)
            {
                var pages =
                    await DocumentService.GetPagesAsync(Id);

                details = DocumentDetailsProjection.Create(
                    document,
                    pages);
            }
        }
        catch (Exception)
        {
            // Do not expose sensitive exception details
            // in the browser.
            loadError =
                "Unable to load document details. " +
                "Check the application logs and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private string ExtractionResult => document?.ProcessingStatus switch
    {
        "Completed" or "CompletedHybrid" when details?.CharacterCount > 0 => "Successful",
        "PartiallyCompleted" => "Partially successful",
        "Failed" => "Failed",
        _ => document?.ProcessingStatus ?? "Unknown"
    };

    private string PagesDetected => document?.PageCount?.ToString() ?? "Unknown";
    private void BackToDocuments() => Navigation.NavigateTo("/documents");

    private static string SourceLabel(string source) => source switch
    {
        "PdfPig" => "PdfPig (native text)",
        "PaddleOcr" => "PaddleOCR",
        "None" => "None",
        _ => "Unknown"
    };

    private static string QualityLabel(string status) => status switch
    {
        "Good" => "Good",
        "NeedsReview" => "Needs review",
        "Missing" => "Missing text",
        _ => "Not evaluated"
    };

    private static string GetQualityClass(string status) => status switch
    {
        "Good" => "diagnostic-status success",
        "NeedsReview" => "diagnostic-status warning",
        "Missing" => "diagnostic-status failure",
        _ => "diagnostic-status neutral"
    };

    private static string GetStatusClass(string status) => status.ToLowerInvariant() switch
    {
        "completed" or "completedhybrid" => "diagnostic-status success",
        "partiallycompleted" or "needsocr" => "diagnostic-status warning",
        "failed" => "diagnostic-status failure",
        _ => "diagnostic-status neutral"
    };

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024L * 1024L) return $"{bytes / 1024d / 1024d:N2} MB";
        if (bytes >= 1024L) return $"{bytes / 1024d:N1} KB";
        return $"{bytes:N0} bytes";
    }
}
